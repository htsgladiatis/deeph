# Порт самого Джарвиса (страница в браузере).
JARVIS_PORT=7788

# Мозг: локальный OpenAI-совместимый маршрут freePi из Andrey DS Harness.
JARVIS_BASE_URL=http://127.0.0.1:39147/freepi/v1
JARVIS_MODEL=deepseek-v4.1-flash

# Либо любой внешний OpenAI-совместимый сервис:
